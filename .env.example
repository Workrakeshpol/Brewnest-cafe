# .env.example

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
# Node environment (development | production | test)
NODE_ENV=development
# Port where the Express server will listen
PORT=3001
# Hostname (used for constructing URLs)
HOST=localhost

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# PostgreSQL connection string – example for local Docker instance
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://brewnest:brewnest@localhost:5432/brewnest

# ----------------------------------------------------------
# Redis (caching / session store)
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------
# JWT – authentication tokens
# ----------------------------------------------------------
# Secret for signing access tokens (must be a strong random string)
JWT_ACCESS_SECRET=your_access_secret_here
# Secret for signing refresh tokens
JWT_REFRESH_SECRET=your_refresh_secret_here
# Access token expiry (e.g., 15m, 1h)
JWT_ACCESS_EXPIRY=15m
# Refresh token expiry (e.g., 7d)
JWT_REFRESH_EXPIRY=7d

# ----------------------------------------------------------
# Bcrypt – password hashing
# ----------------------------------------------------------
BCRYPT_ROUNDS=12

# ----------------------------------------------------------
# CORS – allowed origin for the frontend (change for production)
# ----------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------
# Stripe – payment provider (optional for dev, use test keys)
# ----------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# ----------------------------------------------------------
# SendGrid – email service (optional for dev)
# ----------------------------------------------------------
SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FROM_EMAIL=noreply@brewnest.cafe

# ----------------------------------------------------------
# Gemini AI – optional integration (e.g., chat assistants)
# ----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------
# Additional optional secrets
# ----------------------------------------------------------
# Add any other third‑party keys (e.g., AWS, Twilio) here.
